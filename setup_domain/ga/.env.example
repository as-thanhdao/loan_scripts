# DynamoDB (pynamodb reads these via the boto3 credential chain)
DYNAMODB_TABLE=your-dynamodb-table-name
REGION=eu-west-1
SERVICE=mercury-domain-setup-system
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Route53 runs on the separate "karma" account -- do NOT put these keys in the
# AWS_* variables above, that would point DynamoDB at the wrong account
KARMA_AWS_ACCESS_KEY_ID=your-karma-aws-access-key-id
KARMA_AWS_SECRET_ACCESS_KEY=your-karma-aws-secret-access-key

# Mail systems (used by services/systems.py)
PLUTO_USERNAME=your-pluto-api-username
PLUTO_PASSWORD=your-pluto-api-password
CHARON_USERNAME=your-charon-api-username
CHARON_PASSWORD=your-charon-api-password

# INWX registrar (used by services/inwx_class.py)
INWX_USERNAME=your-inwx-username
INWX_PASSWORD=your-inwx-password

# Cloudflare (used by services/cloudflare_class.py)
CLOUDFLARE_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Universe API (used by add_ips.py / deactivate_ip.py / set_up_domain.py)
UNIVERSE_TOKEN=your-universe-api-token

# Defaults for the CLI scripts
OPERATOR_EMAIL=you@audienceserv.com
CONTACT_ID=567605
